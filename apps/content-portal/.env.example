# Google Cloud OAuth client, configured as an internal Workspace app.
# Authorized redirect URI: https://content.tpkpark.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=https://content.tpkpark.com

# The account must be in this allowlist AND Google's hosted-domain claim must be tpkpark.com.
TPK_CONTENT_ALLOWED_EMAILS=
TPK_CONTENT_WORKSPACE_DOMAIN=tpkpark.com
TPK_CONTENT_SHEET_ID=
